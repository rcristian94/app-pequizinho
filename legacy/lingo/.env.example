# .env.local

# disabled telemetry
DO_NOT_TRACK="1"
NEXT_TELEMETRY_DISABLED="1"
CLERK_TELEMETRY_DISABLED="1"

# clerk auth keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=SET_LOCALLY
CLERK_SECRET_KEY=SET_LOCALLY

# clerk redirect urls
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# neon db uri
DATABASE_URL=SET_LOCALLY

# stripe api key and webhook
STRIPE_API_SECRET_KEY=SET_LOCALLY
STRIPE_WEBHOOK_SECRET=SET_LOCALLY

# public app url
NEXT_PUBLIC_APP_URL=http://localhost:3000

# clerk admin user id(s) separated by comma (,)
CLERK_ADMIN_IDS=SET_LOCALLY
# or CLERK_ADMIN_IDS="user_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx, user_xxxxxxxxxxxxxxxxxxxxxx" for multiple admins.
