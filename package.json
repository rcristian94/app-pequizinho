{
  "name": "pequizinho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inglês para grandes aventuras — MVP Cloudflare do Pequizinho",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:runtime": "npm run build && node scripts/runtime-smoke.mjs",
    "check": "node --check src/worker.mjs && node --check public/app.js && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "node scripts/deploy-guard.mjs",
    "build:staging": "npm run build && node scripts/build-durable.mjs",
    "test:durable": "npm run build:staging && node scripts/durable-smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.156.0",
    "miniflare": "5.20261023.3-beta",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
